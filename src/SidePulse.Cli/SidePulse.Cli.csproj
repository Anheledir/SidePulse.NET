<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>spn</AssemblyName>
    <Version>0.1.0-beta.2</Version>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Description>Unofficial SidePulse companion</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SidePulse.Core/SidePulse.Core.csproj" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../third-party/**/*" Link="Licenses/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" Link="Licenses/SidePulse.NET/LICENSE" />
    <EmbeddedResource Include="../../NOTICE.md" Link="Licenses/SidePulse.NET/NOTICE.md" />
    <EmbeddedResource Include="Dependencies.json" />
    <EmbeddedResource Include="../../docs/wiki/*.md" LogicalName="SidePulse.Cli.Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/releases/$(Version).md" LogicalName="SidePulse.Cli.Docs.Beta.md" />
    <EmbeddedResource Include="$(NetCoreRoot)LICENSE.txt" LogicalName="SidePulse.Cli.Licenses.dotnet.LICENSE.txt" />
    <EmbeddedResource Include="$(NetCoreRoot)ThirdPartyNotices.txt" LogicalName="SidePulse.Cli.Licenses.dotnet.ThirdPartyNotices.txt" />
  </ItemGroup>
</Project>
